{
  "expo": {
    "name": "Tri-Cass Companion",
    "slug": "tri-cass-companion",
    "version": "0.13.0",
    "orientation": "default",
    "icon": "./assets/brand/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "tri-cass-companion",
    "experiments": {
      "baseUrl": "./"
    },
    "splash": {
      "image": "./assets/brand/logo-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#040804"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "bot.grok.nexus.companion",
      "infoPlist": {
        "CFBundleDisplayName": "Tri-Cass Companion",
        "NSLocalNetworkUsageDescription": "Tri-Cass Companion can reach a local Ollama server on your network for offline AI chat.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "bot.grok.nexus.companion",
      "versionCode": 15,
      "softwareKeyboardLayoutMode": "pan",
      "allowBackup": true,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#040804",
        "foregroundImage": "./assets/brand/icon.png"
      },
      "intentFilters": [
        {
          "action": "android.intent.action.MAIN",
          "category": [
            "android.intent.category.LEANBACK_LAUNCHER"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "Tri-Cass Companion",
      "shortName": "Tri-Cass",
      "themeColor": "#39ff14",
      "backgroundColor": "#040804"
    },
    "plugins": [
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#040804",
          "image": "./assets/brand/logo-mark.png"
        }
      ]
    ]
  }
}
