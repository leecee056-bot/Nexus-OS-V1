{
  "expo": {
    "name": "NEXUS Companion",
    "slug": "nexus-companion",
    "version": "0.4.0",
    "orientation": "default",
    "icon": "./assets/brand/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "nexus-companion",
    "experiments": {
      "baseUrl": "./"
    },
    "splash": {
      "image": "./assets/brand/logo-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#040804"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "bot.grok.nexus.companion",
      "infoPlist": {
        "CFBundleDisplayName": "NEXUS Companion",
        "NSLocalNetworkUsageDescription": "NEXUS Companion can reach a local Ollama server on your network for offline AI chat.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "bot.grok.nexus.companion",
      "versionCode": 4,
      "softwareKeyboardLayoutMode": "pan",
      "allowBackup": true,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#040804",
        "foregroundImage": "./assets/brand/icon.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "NEXUS Companion",
      "shortName": "NEXUS",
      "themeColor": "#39ff14",
      "backgroundColor": "#040804"
    },
    "plugins": [
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#040804",
          "image": "./assets/brand/logo-mark.png"
        }
      ]
    ]
  }
}
